# ═══════════════════════════════════════════════════════════
# CHISPA — Environment Variables
# ═══════════════════════════════════════════════════════════
#
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# ───── Supabase ──────────────────────────────────────────
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings → API
# 3. Copy the "Project URL" and "anon public" key below
#
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ───── Supabase Service Role (server-side only!) ─────────
# ⚠️ NEVER expose this to the client.
# Found in: Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ───── Supabase Project Reference ────────────────────────
# Found in: Project Settings → General → Reference ID
# Used for CLI operations and migrations
NEXT_PUBLIC_SUPABASE_PROJECT_REF=your-project-ref

# ───── Supabase Database URL (direct Postgres) ───────────
# Found in: Project Settings → Database → Connection string
# Needed for running SQL migrations manually
# SUPABASE_DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ═══════════════════════════════════════════════════════════
# DEPLOYMENT (Vercel / other)
# ─────────────────────────────────────────────────────────
# NODE_ENV=production

# ═══════════════════════════════════════════════════════════
# OPTIONAL: Local AI (Phase 2/3)
# ─────────────────────────────────────────────────────────
# WEBLLM_CACHE_URL=
# ONNX_WASM_PATH=
