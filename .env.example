# ═══════════════════════════════════════════════════════════
# CHISPA — Environment Variables
# ═══════════════════════════════════════════════════════════
#
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# ═══════════════════════════════════════════════════════════
# REQUIRED: Supabase (auth + sync)
# ═══════════════════════════════════════════════════════════
# Create a free project at https://supabase.com
# Project Settings → API → Project URL + anon public key
# ═══════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PROJECT_REF=your-project-ref

# ⚠️ Server-only: never expose to client.
# Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ═══════════════════════════════════════════════════════════
# OPTIONAL: Sentry (error tracking in production)
# ═══════════════════════════════════════════════════════════
# Create a free account at https://sentry.io
# Create a Next.js project → get DSN from Project Settings → Client Keys
# ═══════════════════════════════════════════════════════════
SENTRY_DSN=https://public-key@o123456.ingest.sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://public-key@o123456.ingest.sentry.io/project-id
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-auth-token

# ═══════════════════════════════════════════════════════════
# OPTIONAL: Stripe (Pro tier subscriptions)
# ═══════════════════════════════════════════════════════════
# Web-native checkout (avoids Apple/Google 30% tax)
# Create products in Stripe Dashboard → get price IDs
# ⚠️ Server-only: never expose secret key to client.
# ═══════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_pro_monthly
NEXT_PUBLIC_STRIPE_LIFETIME_PRICE_ID=price_lifetime_founder
STRIPE_SUCCESS_URL=https://chispa.app/upgrade/success
STRIPE_CANCEL_URL=https://chispa.app/upgrade/cancel

# ═══════════════════════════════════════════════════════════
# OPTIONAL: Build / Dev
# ═══════════════════════════════════════════════════════════
# ANALYZE=true  — Enables @next/bundle-analyzer on next build
